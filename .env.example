# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presentail
LOG_LEVEL=info

# ── Clerk (authentication) ─────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Google Maps JavaScript API (Address Book pins) ────────────────────────────
# This browser key is embedded in the OS web bundle. Restrict it in Google Cloud
# Console to the JavaScript Maps API and HTTP referrers for this app only:
# https://os.presentail.com/* plus the approved development preview origins.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ── Payment providers ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
MAMO_API_KEY=
MAMO_WEBHOOK_SECRET=

# ── Object storage (GCS) ─────────────────────────────────────────────────────
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_JSON=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Marketplace report webhook ────────────────────────────────────────────────
# Bind the direct Toters webhook to one workspace. The request's
# workspace_owner_id must match this server-side value.
MARKETPLACE_WEBHOOK_SECRET=
MARKETPLACE_WEBHOOK_WORKSPACE_OWNER_ID=

# ── WooCommerce ────────────────────────────────────────────────────────────────
WOOCOMMERCE_ENCRYPTION_KEY=

# ── Exchange rates ─────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ── Google Ads read-only analytics ────────────────────────────────────────────
# The service account is used only for metadata/reporting (never conversion
# uploads). GOOGLE_ADS_WORKSPACE_OWNER_ID is an explicit tenancy guard: reports
# run only for this workspace owner. Keep the JSON in a secret manager.
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_WORKSPACE_OWNER_ID=

# ── Tookan (delivery dispatch) ─────────────────────────────────────────────────
TOOKAN_API_KEY=
TOOKAN_BASE_URL=https://api.tookanapp.com
TOOKAN_TIMEZONE=UTC
TOOKAN_AUTO_ASSIGNMENT=false
# Fallback phone number sent to Tookan for branch / stock-request tasks.
# Branch requests route to a warehouse location (no customer phone); Tookan
# rejects create_task when customer_phone is blank, so set this to a valid
# placeholder number (e.g. your warehouse or ops line).
TOOKAN_DEFAULT_PHONE=

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Omnichannel ───────────────────────────────────────────────────────────────
# Enable mock channel adapters for local development (no real provider credentials needed)
MOCK_CHANNELS_ENABLED=true

# Meta / WhatsApp Business API
OMNI_WHATSAPP_VERIFY_TOKEN=
OMNI_WHATSAPP_APP_SECRET=
OMNI_WHATSAPP_ACCESS_TOKEN=
OMNI_WHATSAPP_PHONE_NUMBER_ID=

# Meta / Messenger
OMNI_MESSENGER_VERIFY_TOKEN=
OMNI_MESSENGER_APP_SECRET=
OMNI_MESSENGER_PAGE_ACCESS_TOKEN=
OMNI_MESSENGER_PAGE_ID=

# Meta / Instagram Messaging
OMNI_INSTAGRAM_VERIFY_TOKEN=
OMNI_INSTAGRAM_APP_SECRET=
OMNI_INSTAGRAM_ACCESS_TOKEN=
OMNI_INSTAGRAM_ACCOUNT_ID=

# TikTok Business Messaging
OMNI_TIKTOK_APP_KEY=
OMNI_TIKTOK_APP_SECRET=
OMNI_TIKTOK_ACCESS_TOKEN=
