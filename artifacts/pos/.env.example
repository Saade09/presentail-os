# Base URL of the Presentail OS API (no trailing slash)
# Example: https://your-replit-app.repl.co
EXPO_PUBLIC_OS_API_URL=https://your-os-domain.example.com

# Workspace owner ID from the Presentail OS dashboard
# Found in OS Settings → Workspace → Owner ID
EXPO_PUBLIC_OS_WORKSPACE_ID=your_workspace_owner_id_here

# Workspace API key for read access to live orders (pk_live_...)
# Found in OS Settings → API Keys. Used to authenticate the POS app
# against GET /api/orders and GET /api/orders/:id via the x-api-key header.
EXPO_PUBLIC_OS_API_KEY=pk_live_your_api_key_here
