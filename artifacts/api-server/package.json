  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ../../scripts/publish/verify-clerk-config.mjs && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
