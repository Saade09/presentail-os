{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "os.presentail.com",
        "METRO_WATCH_PNPM": "1"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6787070693",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "$ASC_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-account.json",
        "track": "internal"
      }
    }
  }
}
