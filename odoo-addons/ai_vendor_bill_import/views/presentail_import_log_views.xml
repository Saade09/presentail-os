<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presentail_import_log_list" model="ir.ui.view">
        <field name="name">presentail.import.log.list</field>
        <field name="model">presentail.import.log</field>
        <field name="arch" type="xml">
            <list string="Presentail Import Logs" default_order="create_date desc">
                <field name="presentail_import_id" string="Import ID"/>
                <field name="vendor_bill_id" string="Vendor Bill"/>
                <field name="status" string="Status"/>
                <field name="company_id" string="Company"/>
                <field name="create_date" string="Imported At"/>
            </list>
        </field>
    </record>

    <record id="view_presentail_import_log_form" model="ir.ui.view">
        <field name="name">presentail.import.log.form</field>
        <field name="model">presentail.import.log</field>
        <field name="arch" type="xml">
            <form string="Presentail Import Log">
                <sheet>
                    <group>
                        <group>
                            <field name="presentail_import_id"/>
                            <field name="vendor_bill_id"/>
                            <field name="status"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Error">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Raw Payload">
                        <field name="payload_json" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_presentail_import_log" model="ir.actions.act_window">
        <field name="name">AI Invoice Import Logs</field>
        <field name="res_model">presentail.import.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_presentail_import_log"
        name="AI Invoice Logs"
        parent="account.menu_finance_reports"
        action="action_presentail_import_log"
        sequence="99"
    />
</odoo>
